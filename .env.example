# Google Gemini API Configuration (for AI-powered medical report analysis)
GEMINI_API_KEY=

# Firebase Configuration (for Google Authentication)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (for server-side Firestore operations)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# gRPC settings for Firestore (fix DNS resolution issues)
GRPC_DNS_RESOLVER=
GRPC_ENABLE_FORK_SUPPORT=

# Session Configuration (generate a random 32+ character string)
SESSION_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=
# Server Configuration
PORT=
NODE_ENV=